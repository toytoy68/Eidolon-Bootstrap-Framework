+def _check_no_live_writer(directory_fd):
+    """Readers only: a temporary file of a LIVE import is not a crash residue (Claude R1).
+
+    Never creates the lock: if it exists, a non-blocking SHARED lock on it fails while a writer holds the
+    exclusive one, so inspection answers BUSY instead of PENDING, whose remedy is to remove the residue.
+    """
+    try:
+        fd = os.open(LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory_fd)
+    except FileNotFoundError:
+        return
+    try:
+        _private_file(fd, maximum=0)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise ProfileRegistryError("PROFILE_REGISTRY_BUSY") from None
+        fcntl.flock(fd, fcntl.LOCK_UN)
+    finally:
+        os.close(fd)
+
+
