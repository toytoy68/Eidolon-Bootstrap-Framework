+            normal = TransportLimits(total_seconds=2, connect_seconds=1, read_seconds=1)
+            fetch("https://public.example/", policy=WebPolicy(), resolver=lambda h, p: [PUBLIC],
+                  connector=Script([ok()]), limits=normal)
+            fetch("https://public.example/", policy=WebPolicy(), resolver=lambda h, p: [PUBLIC],
