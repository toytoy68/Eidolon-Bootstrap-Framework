+_DNS_CLOCK = time.monotonic   # bound once: tests that script time.monotonic for the connector are unaffected
+DNS_MAX_IN_FLIGHT = 8          # resolver threads alive at once, abandoned ones included
+_DNS_SLOTS = threading.BoundedSemaphore(DNS_MAX_IN_FLIGHT)
+
+
+class _ResolutionDeadline(TimeoutError):
+    """Name resolution did not finish inside the fetch budget (Claude W1)."""
+
+
+def _bounded_resolver(resolver, real_deadline):
+    """Run each resolution in a worker thread joined with the time left in the fetch budget.
+
+    getaddrinfo has no timeout of its own (resolv.conf retries can last tens of seconds), so without this the
+    total budget did not bound DNS. A late resolver thread is abandoned (daemon), never awaited; its answer
+    is ignored. getaddrinfo cannot be cancelled, so abandoned threads are capped: each holds one of
+    DNS_MAX_IN_FLIGHT slots until it really ends; with no free slot the resolution fails at once (closed). The decision itself still comes from egress.decide/follow, unchanged. It uses the REAL
+    monotonic clock, anchored at the start of fetch: an injected or scripted clock sees no extra call.
+    """
+    def resolve(host, port):
+        remaining = real_deadline - _DNS_CLOCK()
+        if remaining <= 0:
+            raise _ResolutionDeadline()
+        if not _DNS_SLOTS.acquire(blocking=False):
+            raise OSError("too many name resolutions in flight")
+        box = {}
+
+        def run():
+            try:
+                box["value"] = resolver(host, port)
+            except BaseException as exc:  # noqa: BLE001 - re-raised in the caller's thread
+                box["error"] = exc
+            finally:
+                _DNS_SLOTS.release()
+        worker = threading.Thread(target=run, name="eidolon-dns", daemon=True)
+        try:
+            worker.start()
+        except BaseException:
+            _DNS_SLOTS.release()
+            raise
+        worker.join(remaining)
+        if worker.is_alive():
+            raise _ResolutionDeadline()
+        if "error" in box:
+            raise box["error"]
+        return box["value"]
+    return resolve
+
+
