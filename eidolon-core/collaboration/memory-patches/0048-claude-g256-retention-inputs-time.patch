 .../test_retention_inputs_g256.py             | 114 ++++++++++++++++++
 2 files changed, 171 insertions(+), 16 deletions(-)
 create mode 100644 tests/claude_memory_eval/test_retention_inputs_g256.py

diff --git a/tests/claude_memory_eval/generation_retention.py b/tests/claude_memory_eval/generation_retention.py
index dfc5c32..a51bf99 100644
--- a/tests/claude_memory_eval/generation_retention.py
+++ b/tests/claude_memory_eval/generation_retention.py
@@ -35,46 +35,87 @@ class RetentionVerdict:
     reasons: tuple
 
 
-def classify(facts, *, now, grace_seconds, keep_failed_for_review=True):
-    """One verdict per generation. Any unknown or contradictory fact keeps the generation."""
-    if type(now) not in (int, float) or not math.isfinite(now) or now < 0:
+def _flag(value):
+    """A tri-state fact: exactly True, exactly False, or unknown (None or anything ambiguous)."""
+    return value if type(value) is bool else None
+
+
+def _seconds(value):
+    return type(value) in (int, float) and math.isfinite(value)
+
+
+def _audit(value):
+    return (type(value) is str and value.strip() == value and 1 <= len(value) <= 256
+            and value.isprintable())
+
+
+def classify(facts, *, now, grace_seconds, keep_failed_for_review=True, epoch_window=None, not_before=None):
+    """One verdict per generation. Any unknown, ambiguous or contradictory fact keeps the generation.
+
+    epoch_window=(floor, ceiling) lets the host refuse a clock in another unit (milliseconds, dates);
+    not_before is the latest clock this host already used: a regressed clock is refused.
+    """
+    if not _seconds(now) or now < 0:
         raise ValueError("invalid clock")
-    if type(grace_seconds) not in (int, float) or not math.isfinite(grace_seconds) or grace_seconds <= 0:
+    if epoch_window is not None:
+        if (type(epoch_window) is not tuple or len(epoch_window) != 2
+                or not all(_seconds(x) for x in epoch_window) or not 0 <= epoch_window[0] < epoch_window[1]):
+            raise ValueError("invalid epoch window")
+        if not epoch_window[0] <= now <= epoch_window[1]:
+            raise ValueError("implausible clock")
+    if not_before is not None and (not _seconds(not_before) or now < not_before):
+        raise ValueError("clock regressed")
+    if not _seconds(grace_seconds) or grace_seconds <= 0:
         raise ValueError("a positive host-supplied grace period is required")
-    out, targets = [], [f for f in facts if f.is_alias_target is True]
-    names = [f.name for f in facts]
+    facts = tuple(facts)  # a generator must not be consumed by the first pass
+    if any(not isinstance(f, GenerationFacts) for f in facts):
+        raise ValueError("invalid generation facts")
+    names = [f.name for f in facts if type(f.name) is str]
     if len(set(names)) != len(names):
         raise ValueError("duplicate generation")
-    alias_ok = len(targets) == 1 and all(f.is_alias_target is not None for f in facts)
+    # Alias state is judged per alias: one alias's target says nothing about another alias.
+    alias_ok = {}
+    for alias in {f.alias for f in facts if type(f.alias) is str}:
+        group = [f for f in facts if f.alias == alias]
+        alias_ok[alias] = (sum(_flag(f.is_alias_target) is True for f in group) == 1
+                           and all(_flag(f.is_alias_target) is not None for f in group))
+    out = []
     for f in facts:
         reasons = []
-        if not isinstance(f.name, str) or not re.fullmatch(re.escape(f.alias) + r"__[0-9a-f]{32}", f.name):
+        if (type(f.alias) is not str or not f.alias or type(f.name) is not str
+                or not re.fullmatch(re.escape(f.alias) + r"__[0-9a-f]{32}", f.name)):
             out.append(RetentionVerdict(str(f.name), "KEEP_UNCERTAIN", ("FOREIGN_OR_MALFORMED_NAME",)))
             continue
-        if f.is_alias_target is True:
+        if _flag(f.is_alias_target) is True:
             out.append(RetentionVerdict(f.name, "KEEP_ACTIVE", ("ALIAS_TARGET",)))
             continue
-        if not alias_ok:
+        if not alias_ok[f.alias]:
             reasons.append("ALIAS_STATE_UNCERTAIN")
-        if f.descriptor_valid is None or f.complete is None:
+        if _flag(f.descriptor_valid) is None or _flag(f.complete) is None:
             reasons.append("EVIDENCE_UNKNOWN")
         if reasons:
             out.append(RetentionVerdict(f.name, "KEEP_UNCERTAIN", tuple(reasons)))
             continue
-        if f.readers is None or f.readers != 0:
+        if type(f.readers) is not int or f.readers != 0:
             out.append(RetentionVerdict(f.name, "KEEP_READERS",
-                                        ("READERS_UNKNOWN",) if f.readers is None else ("READERS_ACTIVE",)))
+                                        ("READERS_ACTIVE",) if type(f.readers) is int and f.readers > 0
+                                        else ("READERS_UNKNOWN",)))
             continue
         if not f.descriptor_valid or not f.complete:
             # A failed/partial build has no retirement history: a human must look at it.
             verdict = "REVIEW_CANDIDATE" if keep_failed_for_review is False else "KEEP_FAILED_EVIDENCE"
             out.append(RetentionVerdict(f.name, verdict, ("FAILED_OR_PARTIAL_BUILD",)))
             continue
-        if (f.retired_at is None or f.audit_reference is None or type(f.retired_at) not in (int, float)
-                or not math.isfinite(f.retired_at) or f.retired_at > now):
+        if not _seconds(f.retired_at) or f.retired_at < 0 or not _audit(f.audit_reference):
             out.append(RetentionVerdict(f.name, "KEEP_UNCERTAIN", ("RETIREMENT_NOT_PROVEN",)))
             continue
-        if now - f.retired_at < grace_seconds:
+        if f.retired_at > now:
+            out.append(RetentionVerdict(f.name, "KEEP_UNCERTAIN", ("RETIREMENT_IN_FUTURE",)))
+            continue
+        if epoch_window is not None and f.retired_at < epoch_window[0]:
+            out.append(RetentionVerdict(f.name, "KEEP_UNCERTAIN", ("RETIREMENT_TIME_IMPLAUSIBLE",)))
+            continue
+        if now - f.retired_at < grace_seconds:  # the grace bound itself is inclusive: age == grace may go
             out.append(RetentionVerdict(f.name, "KEEP_RECENT", ("WITHIN_GRACE",)))
             continue
         out.append(RetentionVerdict(f.name, "REVIEW_CANDIDATE", ("RETIRED_COMPLETE_NO_READERS",)))
diff --git a/tests/claude_memory_eval/test_retention_inputs_g256.py b/tests/claude_memory_eval/test_retention_inputs_g256.py
new file mode 100644
index 0000000..add2c8b
--- /dev/null
+++ b/tests/claude_memory_eval/test_retention_inputs_g256.py
@@ -0,0 +1,114 @@
+# ==========================================================
+# Projet      : Eidolon Memory Engine
+# Organisation: Eidolon Core Technologies (ECT)
+# Fichier     : tests/claude_memory_eval/test_retention_inputs_g256.py
+# Description : Entrées et cohérence temporelle du classificateur de rétention (Claude, G256-1/2)
+# Standard    : Eidolon Presentation Standard v1
+# ==========================================================
+"""Pure, synthetic. The single property under test: no ambiguous, malformed or temporally
+inconsistent fact may ever produce REVIEW_CANDIDATE. Each case was a REVIEW_CANDIDATE (or a crash)
+on the G252 classifier."""
+import math
+
+import pytest
+
+from tests.claude_memory_eval.generation_retention import GenerationFacts, classify
+
+ALIAS = "eidolon_x"
+NOW = 1_800_000_000.0           # synthetic Unix seconds (2027)
+WINDOW = (946_684_800.0, 4_102_444_800.0)  # host-supplied plausibility window (2000-01-01, 2100-01-01)
+
+
+def gen(n, alias=ALIAS, **over):
+    values = dict(name=f"{alias}__{n:032x}", alias=alias, is_alias_target=False, descriptor_valid=True,
+                  complete=True, readers=0, retired_at=NOW - 7200, audit_reference="audit-1")
+    values.update(over)
+    return GenerationFacts(**values)
+
+
+ACTIVE = gen(1, is_alias_target=True)
+
+
+def verdict(fact, *others, now=NOW, grace=3600, **options):
+    out = classify([ACTIVE, *others, fact], now=now, grace_seconds=grace, **options)
+    return out[-1].verdict, out[-1].reasons
+
+
+def test_the_reference_case_is_a_candidate():
+    assert verdict(gen(2))[0] == "REVIEW_CANDIDATE"
+
+
+@pytest.mark.parametrize("field, value", [
+    ("readers", False), ("readers", 0.0), ("readers", -1), ("readers", math.nan), ("readers", "0"),
+    ("descriptor_valid", "no"), ("descriptor_valid", 1), ("complete", 1), ("complete", "false"),
+    ("complete", math.nan), ("is_alias_target", "true"), ("is_alias_target", 0),
+    ("audit_reference", ""), ("audit_reference", " "), ("audit_reference", 0), ("audit_reference", "a\nb"),
+    ("retired_at", True), ("retired_at", math.nan), ("retired_at", math.inf), ("retired_at", -5.0),
+    ("retired_at", "1700000000"),
+])
+def test_an_ambiguous_fact_is_never_a_candidate(field, value):
+    result, reasons = verdict(gen(2, **{field: value}))
+    assert result.startswith("KEEP_"), (field, value, result, reasons)
+
+
+def test_a_malformed_alias_or_name_keeps_instead_of_crashing():
+    for fact in (gen(2, alias=None, name=f"None__{2:032x}"), gen(2, name=["list"]), gen(2, alias="")):
+        assert verdict(fact)[0] == "KEEP_UNCERTAIN"
+
+
+def test_another_alias_target_does_not_vouch_for_this_alias():
+    assert verdict(gen(2, alias="other"))[0] == "KEEP_UNCERTAIN"
+    assert verdict(gen(2, alias="other"), gen(3, alias="other", is_alias_target=True))[0] == "REVIEW_CANDIDATE"
+
+
+def test_duplicates_and_foreign_objects_are_refused_and_generators_are_complete():
+    with pytest.raises(ValueError):
+        classify([ACTIVE, gen(2), gen(2, readers=1)], now=NOW, grace_seconds=1)
+    with pytest.raises(ValueError):
+        classify([ACTIVE, dict(name="x")], now=NOW, grace_seconds=1)
+    assert [v.verdict for v in classify((f for f in (ACTIVE, gen(2))), now=NOW, grace_seconds=1)] == \
+        ["KEEP_ACTIVE", "REVIEW_CANDIDATE"]
+
+
+# G256-2: time.
+
+def test_retirement_in_the_future_or_after_a_clock_step_back_is_kept():
+    assert verdict(gen(2, retired_at=NOW + 1)) == ("KEEP_UNCERTAIN", ("RETIREMENT_IN_FUTURE",))
+    with pytest.raises(ValueError, match="clock regressed"):
+        classify([ACTIVE, gen(2)], now=NOW, grace_seconds=1, not_before=NOW + 1)
+    assert classify([ACTIVE, gen(2)], now=NOW, grace_seconds=1, not_before=NOW)[1].verdict == "REVIEW_CANDIDATE"
+    with pytest.raises(ValueError):
+        classify([ACTIVE], now=NOW, grace_seconds=1, not_before=math.nan)
+
+
+def test_exact_grace_boundaries():
+    assert verdict(gen(2, retired_at=NOW - 3600))[0] == "REVIEW_CANDIDATE"   # age == grace: inclusive
+    assert verdict(gen(2, retired_at=NOW - 3599.999))[0] == "KEEP_RECENT"
+    assert verdict(gen(2, retired_at=NOW))[0] == "KEEP_RECENT"               # retired this instant
+    assert verdict(gen(2, retired_at=1), now=3601)[0] == "REVIEW_CANDIDATE"   # integers too
+
+
+def test_mixed_units_are_refused_with_a_host_window():
+    # Clock in milliseconds, retirement in seconds: without a window this is indistinguishable
+    # from a very old retirement (documented limit); with the host window it is refused.
+    assert verdict(gen(2, retired_at=1.7e9), now=1.8e12)[0] == "REVIEW_CANDIDATE"
+    with pytest.raises(ValueError, match="implausible clock"):
+        classify([ACTIVE, gen(2, retired_at=1.7e9)], now=1.8e12, grace_seconds=1, epoch_window=WINDOW)
+    # Clock in seconds, retirement in milliseconds: always in the future, kept.
+    assert verdict(gen(2, retired_at=1.7e12))[0] == "KEEP_UNCERTAIN"
+    # Retirement before the plausibility floor (epoch sentinel) is not a proof.
+    assert verdict(gen(2, retired_at=0.0), epoch_window=WINDOW) == \
+        ("KEEP_UNCERTAIN", ("RETIREMENT_TIME_IMPLAUSIBLE",))
+    assert verdict(gen(2), epoch_window=WINDOW)[0] == "REVIEW_CANDIDATE"
+
+
+@pytest.mark.parametrize("options", [
+    dict(now="2027-01-15T08:00:00+00:00"), dict(now=True), dict(now=-1), dict(now=math.inf),
+    dict(grace_seconds=True), dict(grace_seconds=math.nan), dict(epoch_window=(1, 0)),
+    dict(epoch_window=[0, 1]), dict(epoch_window=(0, math.inf)),
+])
+def test_public_refusals_are_value_errors(options):
+    args = dict(now=NOW, grace_seconds=3600)
+    args.update(options)
+    with pytest.raises(ValueError):
+        classify([ACTIVE, gen(2)], **args)
