+def test_schema_upgrade_rebuilds_a_v1_index(tmp_path):
+    (tmp_path / "history").mkdir(parents=True)
+    with sqlite3.connect(tmp_path / "history" / "search_fts5.sqlite3") as c:
+        c.execute("CREATE VIRTUAL TABLE memories_fts USING fts5(information_id UNINDEXED, content, metadata, provenance)")
+    b = make(tmp_path)
+    b.store(Memory(information_id="a", content="migré", metadata={"owner": "alice"}))
+    assert [r.memory.information_id for r in b.search("migré", {"owner": "alice"})] == ["a"]
