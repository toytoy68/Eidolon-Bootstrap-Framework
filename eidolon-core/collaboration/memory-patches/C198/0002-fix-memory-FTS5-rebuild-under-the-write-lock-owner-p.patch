diff --git a/core/backend/authorized_memory_experimental.py b/core/backend/authorized_memory_experimental.py
index ca2d4b1..64bcb08 100644
--- a/core/backend/authorized_memory_experimental.py
+++ b/core/backend/authorized_memory_experimental.py
@@ -61,10 +61,14 @@ class AuthorizedMemory:
         return allowed[offset:offset + limit]
 
     def search(self, query: str, options: dict[str, Any] | None = None) -> list[Any]:
-        # Searches the raw backend before filtering; leaks through untrusted
-        # code or side channels remain possible. Do not deploy as a security boundary.
-        candidates = self._backend.search(query, {"limit": 10_000})
+        # The owner is applied inside the index query, before ranking and LIMIT, so
+        # other owners can neither starve nor rank against this principal's results.
+        # The post-filter is kept as defence in depth. Still not a security boundary
+        # against code that can reach the raw backend, filesystem or SQLite file.
+        if not getattr(self._backend, "supports_owner_filter", False):
+            raise PermissionError("backend cannot pre-filter by owner")
         limit = max(1, min(10_000, int((options or {}).get("limit", 100))))
+        candidates = self._backend.search(query, {"limit": limit, "owner": self.principal.user_id})
         return [
             x for x in candidates
             if x.memory.metadata.get("owner") == self.principal.user_id
