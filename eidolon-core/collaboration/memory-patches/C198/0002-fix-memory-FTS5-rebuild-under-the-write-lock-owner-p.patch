+def test_r8_fts5_owner_filter_is_applied_in_the_index(tmp_path):
+    b = make(tmp_path)
+    b.store(Memory(information_id="a", content="partagé", metadata={"owner": "alice"}))
+    b.store(Memory(information_id="b", content="partagé", metadata={"owner": "bob"}))
+    assert [r.memory.information_id for r in b.search("partagé", {"owner": "alice"})] == ["a"]
+    with pytest.raises(ValueError):
+        b.search("partagé", {"owner": ""})
+
+
