From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 14:54:29 +0000
Subject: [PATCH] test(claude-eval): G266-8 projection boundaries

Fixes a regression of my G262-8 bound: returning to an already projected
(revision, digest) was refused with a full budget although it adds no
point. The chunker's own ceiling (10000) is named and reported as
CHUNKER_CEILING, distinct from PASSAGES_PER_ARCHIVE and POINTS. An archive
absent then restored is served again without new points; a refusal never
changes what was served.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Rv89UzspoLREq2u9UkZssh
---
 .../archive_passage_projection.py             | 33 ++++---
 .../test_projection_boundaries_g266.py        | 89 +++++++++++++++++++
 2 files changed, 109 insertions(+), 13 deletions(-)
 create mode 100644 tests/claude_memory_eval/test_projection_boundaries_g266.py

diff --git a/tests/claude_memory_eval/archive_passage_projection.py b/tests/claude_memory_eval/archive_passage_projection.py
index 73d64ee..e818774 100644
--- a/tests/claude_memory_eval/archive_passage_projection.py
+++ b/tests/claude_memory_eval/archive_passage_projection.py
@@ -18,6 +18,7 @@ from core.indexing.worker_canonical import CanonicalReader
 from core.retrieval.archive_chunks import chunk_messages, validate_reference
 
 PROJECTION_ID = "archive-passage-v1:1200:160"
+CHUNKER_CEILING = 10000   # chunk_messages' own maximum: a ceiling of the chunker, not an operator budget
 _NAMESPACE = uuid.UUID("5b7f0a52-6a8e-4c39-9f5e-2b3c1d7e9a10")
 
 
@@ -72,22 +73,27 @@ class ArchivePassageProjection:
             # Same bytes already projected: nothing new to stage, so no chunking work at all.
             return tuple(pid for pid, p in self.points.items() if p["information_id"] == information_id
                          and (p["revision"], p["canonical_sha256"]) == (memory.revision, digest))
-        # G262-8: every point of a new revision is new, so the budgets bound the chunking itself. The
-        # chunker stops at `bound` chunks instead of materialising the whole archive before a refusal.
-        # Whitespace-only chunks count toward the bound: the refusal can be conservative, never permissive.
-        limits = [10000]
+        # G262-8: the budgets bound the chunking itself. G266-8: only bytes NEVER projected before produce
+        # new points; returning to an older (revision, digest) reuses stored points and costs nothing.
+        # Whitespace-only chunks count toward the bound: a refusal can be conservative, never permissive.
+        known = any(p["information_id"] == information_id
+                    and (p["revision"], p["canonical_sha256"]) == (memory.revision, digest)
+                    for p in self.points.values())
+        limits = {"CHUNKER_CEILING": CHUNKER_CEILING}
         if self.max_passages is not None:
-            limits.append(self.max_passages + 1)
-        if self.max_points is not None:
-            limits.append(max(self.max_points - len(self.points), 0) + 1)
-        bound = min(limits)
+            limits["PASSAGES_PER_ARCHIVE"] = self.max_passages + 1
+        if self.max_points is not None and not known:
+            limits["POINTS"] = max(self.max_points - len(self.points), 0) + 1
+        bound = min(limits.values())
         try:
             chunks = chunk_messages(memory.content, max_chars=1200, overlap=160, max_chunks=bound)
         except ValueError as exc:
-            if bound < 10000 and "chunk limit" in str(exc):
-                raise ProjectionBudgetExceeded("PASSAGES_PER_ARCHIVE" if self.max_passages is not None
-                                               and bound == self.max_passages + 1 else "POINTS") from None
-            raise
+            if "chunk limit" not in str(exc):
+                raise
+            # Name the binding limit; a budget wins over the ceiling when both are equal.
+            binding = [code for code in ("PASSAGES_PER_ARCHIVE", "POINTS", "CHUNKER_CEILING")
+                       if limits.get(code) == bound][0]
+            raise ProjectionBudgetExceeded(binding) from None
         staged = {}
         for chunk in chunks:
             if not chunk.text.strip():
@@ -99,7 +105,8 @@ class ArchivePassageProjection:
                                _vector_text=sha256(chunk.text.encode()).hexdigest())  # stand-in, no text
         if self.max_passages is not None and len(staged) > self.max_passages:
             raise ProjectionBudgetExceeded("PASSAGES_PER_ARCHIVE")
-        if self.max_points is not None and len(self.points) + len(staged) > self.max_points:
+        new = sum(1 for pid in staged if pid not in self.points)
+        if self.max_points is not None and len(self.points) + new > self.max_points:
             raise ProjectionBudgetExceeded("POINTS")
         self.points.update(staged)
         self.current[information_id] = (memory.revision, digest)
diff --git a/tests/claude_memory_eval/test_projection_boundaries_g266.py b/tests/claude_memory_eval/test_projection_boundaries_g266.py
new file mode 100644
index 0000000..46de057
--- /dev/null
+++ b/tests/claude_memory_eval/test_projection_boundaries_g266.py
@@ -0,0 +1,89 @@
+# ==========================================================
+# Projet      : Eidolon Memory Engine
+# Organisation: Eidolon Core Technologies (ECT)
+# Fichier     : tests/claude_memory_eval/test_projection_boundaries_g266.py
+# Description : Projection : plafond du découpeur, retour à une ancienne empreinte, archive absente (Claude, G266-8)
+# Standard    : Eidolon Presentation Standard v1
+# ==========================================================
+"""Synthetic archives, in-memory projection; experimental, no compaction, no production wiring."""
+import pytest
+
+import tests.claude_memory_eval.archive_passage_projection as proj
+from tests.claude_memory_eval.test_archive_projection_budget_g258 import revise, store, words
+from tests.test_contextual_recall import backend
+
+
+CEIL = 10000                                                         # chunk_messages default ceiling
+
+
+def projection(data, **budget):
+    return proj.ArchivePassageProjection(data.persistent_root, score=lambda t, p: 1.0, **budget)
+
+
+def many(n):
+    return [f"m{i}" for i in range(n)]                               # one passage per message
+
+
+def refused(index, name):
+    with pytest.raises(proj.ProjectionBudgetExceeded) as caught:
+        index.project(name)
+    return caught.value.code
+
+
+@pytest.mark.parametrize("messages, budget, outcome", [
+    (CEIL, {}, CEIL),                       # exactly the ceiling: accepted
+    (CEIL + 1, {}, "CHUNKER_CEILING"),
+    (CEIL + 1, {"max_passages_per_archive": CEIL}, "CHUNKER_CEILING"),
+    (CEIL, {"max_passages_per_archive": CEIL - 1}, "PASSAGES_PER_ARCHIVE"),
+    (CEIL, {"max_points": CEIL - 1}, "POINTS"),
+    (CEIL, {"max_points": CEIL}, CEIL),
+])
+def test_near_the_chunker_ceiling_each_limit_has_its_own_code(tmp_path, messages, budget, outcome):
+    assert getattr(proj, "CHUNKER_CEILING", None) == CEIL               # the ceiling is named, not implicit
+    data = backend(tmp_path)
+    store(data, "big", many(messages))
+    index = projection(data, **budget)
+    if isinstance(outcome, int):
+        assert len(index.project("big")) == outcome
+    else:
+        assert refused(index, "big") == outcome and index.points == {} and index.current == {}
+
+
+def test_returning_to_an_older_digest_reuses_its_points_even_with_a_full_budget(tmp_path):
+    data = backend(tmp_path)
+    memory = store(data, "a", ["q", words(300, "v1")])
+    leaf = data.persistent_root / "a.md"
+    v1 = leaf.read_bytes()
+    index = projection(data, max_points=6)
+    first = index.project("a")
+    revise(data, memory, ["q", words(300, "v2")])
+    index.project("a")
+    assert len(index.points) == 6                                    # budget full
+    leaf.write_bytes(v1)                                             # canonical bytes back to revision 1
+    assert index.project("a") == first and len(index.points) == 6    # nothing new, accepted
+    assert {h.ranking["revision"] for h in index.query("q", limit=10)} == {1}
+
+
+def test_an_archive_absent_then_restored_is_served_again_without_new_points(tmp_path):
+    data = backend(tmp_path)
+    store(data, "a", ["q", words(300, "v1")])
+    leaf = data.persistent_root / "a.md"
+    index = projection(data, max_points=3)
+    ids = index.project("a")
+    leaf.rename(tmp_path / "away.md")
+    with pytest.raises(ValueError):
+        index.project("a")
+    assert index.query("q", limit=10) == [] and len(index.points) == 3
+    (tmp_path / "away.md").rename(leaf)
+    assert index.project("a") == ids and index.query("q", limit=10)
+
+
+def test_a_refusal_never_changes_what_was_served(tmp_path):
+    data = backend(tmp_path)
+    memory = store(data, "a", ["q", words(300, "v1")])
+    index = projection(data, max_points=3)
+    index.project("a")
+    before = (dict(index.points), dict(index.current), [h.ranking for h in index.query("q", limit=10)])
+    revise(data, memory, many(50))
+    assert refused(index, "a") == "POINTS"
+    assert (index.points, index.current, [h.ranking for h in index.query("q", limit=10)]) == before
