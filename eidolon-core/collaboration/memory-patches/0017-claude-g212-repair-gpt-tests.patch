Subject: [PATCH 17/18] test(memory): G212 repair GPT tests: literal \n syntax
 error, exact-limit truncation case, umask-dependent schema test

tests/test_reconcile_preview.py did not even import since f44f84d (literal
backslash-n in two lines). Once importable, test_reject_truncated_journal
used one intent with limit=1, which is now (correctly) an exact limit.
test_rejects_unknown_schema_without_mutation failed under umask 022.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Rv89UzspoLREq2u9UkZssh
---
 tests/test_journal_migration.py | 1 +
 tests/test_reconcile_preview.py | 7 +++++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/tests/test_journal_migration.py b/tests/test_journal_migration.py
index 999af32..f8de9a1 100644
--- a/tests/test_journal_migration.py
+++ b/tests/test_journal_migration.py
@@ -41,6 +41,7 @@ def test_rejects_unknown_schema_without_mutation(tmp_path):
     path = tmp_path / "journal.sqlite3"
     with sqlite3.connect(path) as db:
         db.execute("CREATE TABLE intents (x INTEGER)")
+    path.chmod(0o600)  # private like a real journal: test the schema check, not the umask
     with pytest.raises(ValueError, match="unknown journal schema"):
         migrate_v2(path)
     with sqlite3.connect(path) as db:
diff --git a/tests/test_reconcile_preview.py b/tests/test_reconcile_preview.py
index 5af287a..32aa43c 100644
--- a/tests/test_reconcile_preview.py
+++ b/tests/test_reconcile_preview.py
@@ -32,14 +32,17 @@ def test_stale_intent_may_be_closed_after_grace(tmp_path):
     journal = ChangeJournal(tmp_path / "changes.sqlite3")
     journal.begin("doc", 1, "UPSERT", "a" * 64)
     created = journal.pending()[0].created
-    from core.indexing.reconcile_plan import ABSENT\n    result = preview_reconciliation(journal, {"doc": ABSENT}, {}, now=created + 601)
-    assert result.actions[0].kind == "CLOSE_ABANDONED"\n    assert result.requires_review
+    from core.indexing.reconcile_plan import ABSENT
+    result = preview_reconciliation(journal, {"doc": ABSENT}, {}, now=created + 601)
+    assert result.actions[0].kind == "CLOSE_ABANDONED"
+    assert result.requires_review
     assert journal.pending()[0].state == "INTENT"
 
 
 def test_reject_truncated_journal(tmp_path):
     journal = ChangeJournal(tmp_path / "changes.sqlite3")
     journal.begin("doc", 1, "DELETE")
+    journal.begin("other", 1, "DELETE")                 # two pending, limit one: truncated (one is exact)
     with pytest.raises(ValueError, match="truncated"):
         preview_reconciliation(journal, {}, {}, limit=1)
 
