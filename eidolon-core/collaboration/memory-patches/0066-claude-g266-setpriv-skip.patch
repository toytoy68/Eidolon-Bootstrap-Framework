From 434fcf204f1a07e7654efdbb050ebfbe72ec8e68 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 14:56:33 +0000
Subject: [PATCH] test(claude-eval): skip with reason where setpriv cannot drop
 privileges

The relaunch under nobody is probed first (setpriv ... id -u must print 65534).
In a root runtime without that capability (setresuid: Invalid argument) both
tests are SKIPPED with the error, never passed or failed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Rv89UzspoLREq2u9UkZssh
---
 .../test_readonly_canon_inventory_g262.py     | 18 +++++++++++++++--
 .../test_storage_check_review_g264.py         | 20 +++++++++++++++++--
 2 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/tests/claude_memory_eval/test_readonly_canon_inventory_g262.py b/tests/claude_memory_eval/test_readonly_canon_inventory_g262.py
index 582dd10..082bff1 100644
--- a/tests/claude_memory_eval/test_readonly_canon_inventory_g262.py
+++ b/tests/claude_memory_eval/test_readonly_canon_inventory_g262.py
@@ -180,8 +180,9 @@ def test_the_permission_case_was_executed_somewhere():
     """Under root this file re-runs its permission tests under nobody, so they are never silently skipped."""
     if UNPRIVILEGED:
         return
-    if not os.path.exists("/usr/bin/setpriv"):
-        pytest.skip("no setpriv to drop privileges")
+    refused = _privilege_drop_refused()
+    if refused:
+        pytest.skip(refused)
     import shutil
     import tempfile
     copy = Path(tempfile.mkdtemp(prefix="g262-ro-"))
@@ -200,3 +201,16 @@ def test_the_permission_case_was_executed_somewhere():
         assert r.returncode == 0 and "2 passed" in r.stdout, r.stdout + r.stderr
     finally:
         shutil.rmtree(copy, ignore_errors=True)
+
+
+def _privilege_drop_refused():
+    """None when `setpriv` can really switch to nobody here; otherwise the reason (e.g. a root runtime
+    without CAP_SETUID returns `setresuid: Invalid argument`). The caller SKIPS with it, never passes."""
+    import shutil
+    if not shutil.which("setpriv"):
+        return "no setpriv to drop privileges"
+    probe = subprocess.run(["setpriv", "--reuid=65534", "--regid=65534", "--clear-groups", "id", "-u"],
+                           capture_output=True, text=True, timeout=30)
+    if probe.returncode != 0 or probe.stdout.strip() != "65534":
+        return f"this runtime cannot drop privileges: {(probe.stderr or probe.stdout).strip()[:200]}"
+    return None
diff --git a/tests/claude_memory_eval/test_storage_check_review_g264.py b/tests/claude_memory_eval/test_storage_check_review_g264.py
index 2cbe038..1533c75 100644
--- a/tests/claude_memory_eval/test_storage_check_review_g264.py
+++ b/tests/claude_memory_eval/test_storage_check_review_g264.py
@@ -200,8 +200,11 @@ def test_an_unreadable_canonical_file_is_not_ready(tmp_path):
 
 
 def test_the_unprivileged_cases_were_executed():
-    if os.geteuid() != 0 or not Path("/usr/bin/setpriv").exists():
-        return
+    if os.geteuid() != 0:
+        return                                                   # already unprivileged: ran directly
+    refused = _privilege_drop_refused()
+    if refused:
+        pytest.skip(refused)
     import shutil
     import tempfile
     base = Path(tempfile.mkdtemp(prefix="g264-nobody-"))         # /tmp, not the root-only pytest tmp
@@ -224,6 +227,19 @@ def _run_unprivileged(copy):
     assert r.returncode == 0 and "1 passed" in r.stdout, r.stdout[-2000:] + r.stderr[-2000:]
 
 
+def _privilege_drop_refused():
+    """None when `setpriv` can really switch to nobody here; otherwise the reason (e.g. a root runtime
+    without CAP_SETUID returns `setresuid: Invalid argument`). The caller SKIPS with it, never passes."""
+    import shutil
+    if not shutil.which("setpriv"):
+        return "no setpriv to drop privileges"
+    probe = subprocess.run(["setpriv", "--reuid=65534", "--regid=65534", "--clear-groups", "id", "-u"],
+                           capture_output=True, text=True, timeout=30)
+    if probe.returncode != 0 or probe.stdout.strip() != "65534":
+        return f"this runtime cannot drop privileges: {(probe.stderr or probe.stdout).strip()[:200]}"
+    return None
+
+
 # --- G264-4: CLI separation and exit codes --------------------------------------------------------
 
 @pytest.mark.parametrize("args", [["--port", "18765"], ["--reranker-cache", "/nonexistent"]])
