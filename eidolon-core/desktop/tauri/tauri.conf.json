{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eidolon Consultation",
  "version": "0.1.0",
  "identifier": "local.eidolon.consultation",
  "build": {
    "frontendDist": "./fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
