    {
      "id": "W01",
      "title": "Fournisseur A en 429 avec Retry-After long, B disponible",
      "category": "quota",
      "why": "Un 429 n'est ni une absence de résultat ni une raison d'attendre au-delà du budget.",
      "setup": {
        "query": "synthetic tool max_workers default",
        "providers": {
          "engine-a": {
            "status": "http_429",
            "retry_after_seconds": 120
          },
          "engine-b": {
            "status": "ok",
            "results": [
              {
                "url": "https://docs.synthetic-tool.example/config",
                "title": "Configuration reference",
                "snippet": "max_workers defaults to 4"
              }
            ]
          }
        },
        "provider_order": [
          "engine-a",
          "engine-b"
        ],
        "pages": {
          "https://docs.synthetic-tool.example/config": {
            "status": 200,
            "headers": {
              "Content-Type": "text/html; charset=utf-8"
            },
            "body": "bodies/docs-v2.html",
            "body_sha256": "48b615504024806a96e78406fa8ae538593b6834ba2a9e635ef9433ed7f72648",
            "size": 384
          }
        },
        "cache": [],
        "robots": {},
        "policy": {
          "blocked_domains": []
        },
        "budget": {
          "provider_calls": 4,
          "page_fetches": 5,
          "seconds": 30
        }
      },
      "expected": {
        "outcome": "ANSWERED",
        "providers": {
          "engine-a": "RATE_LIMITED",
          "engine-b": "USED"
        },
        "items": [
          {
            "url": "https://docs.synthetic-tool.example/config",
            "state": "READ"
          }
        ],
        "provider_calls_max": 2,
        "must_not": [
          "retry_before_retry_after",
          "sleep_beyond_budget"
        ]
      }
    },
