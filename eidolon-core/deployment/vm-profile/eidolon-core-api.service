[Unit]
Description=Eidolon Core beta local conversation API
After=network.target eidolon-gpu-tunnel.service eidolon-memory-tunnel.service
Wants=eidolon-gpu-tunnel.service eidolon-memory-tunnel.service
[Service]
Type=simple
User=toytoy
Group=toytoy
WorkingDirectory=/opt/eidolon-core/bootstrap/eidolon-core
ExecStart=/opt/eidolon-core/bootstrap/eidolon-core/.venv/bin/python -m eidolon_core.http_api --state /home/toytoy/eidolon-beta/state --token-file /home/toytoy/eidolon-beta/read-token --port 8767 --web-root /opt/eidolon-core/bootstrap/eidolon-core/desktop/connected --conversations /home/toytoy/eidolon-beta/dialogue-gpu.json --memory-bridge-token-file /home/toytoy/eidolon-beta/memory-bridge-token --comm-port 8766 --monitor-port 8768
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
