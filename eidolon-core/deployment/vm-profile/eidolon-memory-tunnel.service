# Eidolon Core Technologies (ECT) — restricted VM memory tunnel, 2026-10-12
# The dedicated key and pinned known-hosts file are private operator artifacts.
[Unit]
Description=Eidolon restricted Core to Memory loopback tunnel
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=toytoy
Group=toytoy
ExecStart=/usr/bin/ssh -F /dev/null -NT -o BatchMode=yes -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ConnectTimeout=5 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o UserKnownHostsFile=/home/toytoy/.ssh/eidolon-memory-known-hosts -i /home/toytoy/.ssh/eidolon-memory-bridge -L 127.0.0.1:18765:127.0.0.1:18765 toytoy@192.168.1.110
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
