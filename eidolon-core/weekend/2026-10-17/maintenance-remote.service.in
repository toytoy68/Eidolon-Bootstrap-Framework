# Eidolon Core Technologies (ECT) — candidate for the Memory VM, no installation performed
[Unit]
Description=Eidolon passage maintenance with live Core activity
After=network.target
[Service]
Type=oneshot
User=__ACCOUNT_TO_APPROVE__
Group=__GROUP_TO_APPROVE__
WorkingDirectory=__CORE_SOURCE_ON_MEMORY_VM__
Environment=PYTHONPATH=__CORE_SOURCE_ON_MEMORY_VM__/src:__MEMORY_SOURCE__
ExecStart=__PYTHON__ -m eidolon_core.maintenance_host --policy __POLICY_JSON__ --activity-core-port __LOCAL_FORWARD_TO_CORE_PORT__ --activity-token-file __PRIVATE_CORE_READ_TOKEN__ --runtime __PROFILE_MAINTENANCE_JSON__ --execute
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__PRIVATE_STATE_DIRECTORY__ __CANONICAL_ROOT__/.write.lock
ReadOnlyPaths=__ISOLATED_PROFILE_ROOT__ __MODEL_CACHE__ __PRIVATE_CONFIG_DIRECTORY__
TimeoutStartSec=120
